{part === 'body' && (<Fragment>
<div id="optin" class="optin" role="dialog" aria-labelledby="optin-h" aria-modal="false" hidden>
  <form id="optin-form" novalidate>
    <button type="button" class="optin-x" data-dismiss aria-label="Close">&times;</button>
    <h3 id="optin-h">Hiring for ML / inference roles?</h3>
    <p>Leave your email and Karthik will reach out.</p>
    <label for="optin-email">Email <span>(optional)</span></label>
    <input id="optin-email" type="email" autocomplete="email" placeholder="you@company.com" />
    <p id="optin-err" class="optin-err" role="alert" hidden>Please enter a valid email.</p>
    <label class="optin-check"><input id="optin-ok" type="checkbox" /> I'm hiring or know a role that fits</label>
    <div class="optin-btns">
      <button type="submit" id="optin-submit" class="btn btn-primary" disabled>Submit</button>
      <button type="button" class="btn btn-ghost" data-dismiss>No thanks</button>
    </div>
  </form>
  <p id="optin-thanks" class="optin-thanks" hidden>Thanks! Karthik will be in touch.</p>
</div>

<script is:inline>
(function () {
  var ph = function () { return window.posthog; };
  function ls(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function ss(k, v) { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch (e) { return null; } }

  // Named click events (autocapture also records raw clicks)
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (/\.pdf($|\?)/i.test(href) || /resume/i.test(href)) ph().capture('resume_click', { href: href });
    else if (/^mailto:|github\.com|linkedin\.com|(^|\/\/)(www\.)?(x|twitter)\.com/i.test(href)) ph().capture('outbound_click', { href: href });
  }, true);

  // blog_read_complete: once per page view on /blog/<slug> or /projects/<slug>
  var path = location.pathname;
  if (/^\/(blog|projects)\/[^/]+/.test(path)) {
    var done = false;
    var onScroll = function () {
      var d = document.documentElement;
      if (done || (window.scrollY + window.innerHeight) / d.scrollHeight < 0.9) return;
      done = true; window.removeEventListener('scroll', onScroll);
      ph().capture('blog_read_complete', { path: path });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Opt-in card
  var DONE = 'optin_done', DISMISS = 'optin_dismissed_at', TIME = 'optin_active_ms', NEED = 180000;
  var test = /[?&]optin_test=1/.test(location.search);
  var SEEN = 'optin_seen';
  if (!test && (ls(DONE) || ls(DISMISS) || ls(SEEN))) return;

  var card = document.getElementById('optin'), form = document.getElementById('optin-form');
  var email = document.getElementById('optin-email'), ok = document.getElementById('optin-ok');
  var submit = document.getElementById('optin-submit'), err = document.getElementById('optin-err');
  var lastFocus;

  function show() {
    if (!card.hidden) return;
    lastFocus = document.activeElement;
    if (!test) ls(SEEN, '1');
    card.hidden = false; email.focus({ preventScroll: true });
  }
  function close() { card.hidden = true; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
  function dismiss() { ls(DISMISS, String(Date.now())); ph().capture('hire_optin_dismissed', { page: path }); close(); }

  ok.addEventListener('change', function () { submit.disabled = !ok.checked; });
  card.querySelectorAll('[data-dismiss]').forEach(function (b) { b.addEventListener('click', dismiss); });
  card.addEventListener('keydown', function (e) { if (e.key === 'Escape') dismiss(); });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var v = email.value.trim();
    if (v && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) { err.hidden = false; email.focus(); return; }
    err.hidden = true;
    var props = { interested: true, page: path };
    if (v) { props.email = v; ph().identify(v, { email: v }); }
    ph().capture('hire_interest', props);
    ls(DONE, '1');
    form.hidden = true; document.getElementById('optin-thanks').hidden = false;
    setTimeout(close, 3000);
  });

  if (test) { setTimeout(show, 5000); return; }

  // Accumulate visible time across pages in this session
  var acc = Number(ss(TIME) || 0), since = document.visibilityState === 'visible' ? Date.now() : 0;
  function flush() { if (since) { acc += Date.now() - since; since = document.visibilityState === 'visible' ? Date.now() : 0; ss(TIME, String(acc)); } }
  document.addEventListener('visibilitychange', function () { flush(); if (!since && document.visibilityState === 'visible') since = Date.now(); });
  window.addEventListener('pagehide', flush);
  var timer = setInterval(function () { flush(); if (acc >= NEED) { clearInterval(timer); show(); } }, 5000);
})();
</script>
</Fragment>)}

<style>
  .optin { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 1000; width: min(340px, calc(100vw - 2rem));
    background: var(--surface-raised); color: var(--ink); border: 1px solid var(--border-strong); border-radius: 12px;
    padding: 1.1rem 1.2rem; box-shadow: 0 12px 32px rgba(0,0,0,.18); font-size: .92rem; }
  .optin[hidden] { display: none; }
  .optin h3 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 1.35rem; margin: 0 1.5rem .3rem 0; }
  .optin p { color: var(--ink-secondary); margin: 0 0 .75rem; }
  .optin label { display: block; font-weight: 500; margin-bottom: .3rem; }
  .optin label span { color: var(--ink-muted); font-weight: 400; }
  .optin input[type=email] { width: 100%; box-sizing: border-box; padding: .5rem .6rem; border: 1px solid var(--border-strong);
    border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; margin-bottom: .6rem; }
  .optin input:focus-visible, .optin button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .optin .optin-check { display: flex; gap: .5rem; align-items: center; font-weight: 400; margin: .2rem 0 .9rem; }
  .optin .optin-err { color: #dc2626; font-size: .85rem; margin: -.3rem 0 .5rem; }
  .optin-btns { display: flex; gap: .5rem; }
  .optin .btn { padding: .45rem .9rem; border-radius: 8px; font: inherit; cursor: pointer; border: 1px solid var(--border-strong); }
  .optin .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .optin .btn-primary:disabled { opacity: .45; cursor: not-allowed; }
  .optin .btn-ghost { background: transparent; color: var(--ink-secondary); }
  .optin-x { position: absolute; top: .5rem; right: .6rem; background: none; border: 0; font-size: 1.4rem; line-height: 1;
    color: var(--ink-muted); cursor: pointer; }
  .optin-thanks { margin: 0; color: var(--ink); }
  @media (max-width: 600px) {
    .optin { left: 0; right: 0; bottom: 0; width: auto; border-radius: 14px 14px 0 0; border-bottom: 0; padding-bottom: 1.5rem; }
  }
</style>
