---
import data from '../data/data.json';
const { view } = Astro.props;
const cat = view === 'sde' ? 'SDE' : 'Data Science';
const projects = view === 'all' ? data.projects : data.projects.filter((p) => p.category === cat || p.category === 'Both');
---
<div class="sde-projects-grid">
  {
    projects.map((proj) => (
      <div class="project-card-compact">
        <h3>{proj.page ? <a href={proj.page}>{proj.title}</a> : proj.title}</h3>
        <p>{proj.description}</p>
        <div class="project-tags">
          {proj.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
        <p class="project-links">
          {proj.page && <a href={proj.page}><i class="fas fa-external-link-alt"></i> Project page</a>}
          {proj.page && ' · '}
          <a href={proj.github}><i class="fab fa-github"></i> Code</a>
        </p>
      </div>
    ))
  }
</div>
