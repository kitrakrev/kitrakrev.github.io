---
import { getProjects } from '../lib/repos';
const { view } = Astro.props;
const cat = view === 'sde' ? 'SDE' : 'Data Science';
const all = await getProjects();
const projects = view === 'all' ? all : all.filter((p) => p.category === cat || p.category === 'Both');
---
<div class="project-pager" data-per-page="6">
<div class="sde-projects-grid">
  {
    projects.map((proj) => (
      <div class="project-card-compact">
        <a class="proj-media" href={proj.page || proj.github} aria-hidden="true" tabindex="-1">
          {proj.thumb ? <img src={proj.thumb} alt="" loading="lazy" /> : <i class={`fas ${proj.icon || 'fa-code'}`}></i>}
        </a>
        {proj.badge && <span class="proj-badge">{proj.badge}</span>}
        <h3>{proj.page ? <a href={proj.page}>{proj.title}</a> : proj.title}</h3>
        <p>{proj.description}</p>
        <div class="project-tags">
          {proj.tags.slice(0, 4).map((t, i) => (
            <span class={i < 2 && !proj.auto ? 'tag tag-domain' : 'tag'}>{t}</span>
          ))}
        </div>
        <p class="project-links">
          {proj.page && <a href={proj.page}><i class="fas fa-external-link-alt"></i> Project page</a>}
          {proj.page && ' · '}
          <a href={proj.github}><i class="fab fa-github"></i> Code</a>
        </p>
      </div>
    ))
  }
</div>
<nav class="pager-controls" hidden>
  <button type="button" class="pager-prev" aria-label="Previous projects">&larr; Prev</button>
  <span class="pager-status" aria-live="polite"></span>
  <button type="button" class="pager-next" aria-label="Next projects">Next &rarr;</button>
</nav>
</div>

<script>
  document.querySelectorAll('.project-pager').forEach((root) => {
    const per = Number(root.dataset.perPage) || 6;
    const cards = [...root.querySelectorAll('.project-card-compact')];
    const pages = Math.ceil(cards.length / per);
    if (pages <= 1) return;
    const nav = root.querySelector('.pager-controls');
    const prev = nav.querySelector('.pager-prev');
    const next = nav.querySelector('.pager-next');
    const status = nav.querySelector('.pager-status');
    let page = 0;
    const show = () => {
      cards.forEach((c, i) => { c.hidden = Math.floor(i / per) !== page; });
      status.textContent = `${page + 1} / ${pages}`;
      prev.disabled = page === 0;
      next.disabled = page === pages - 1;
    };
    prev.addEventListener('click', () => { page--; show(); });
    next.addEventListener('click', () => { page++; show(); });
    nav.hidden = false;
    show();
  });
</script>
